APP_NAME="IBN ALSHAM"
APP_ENV=local
APP_KEY=base64:GENERATE_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ibn_alsham_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS=firebase-credentials.json

# SMS Gateway (for future use)
SMS_PROVIDER=test
SMS_API_KEY=
SMS_SENDER_ID=IBNALSHAM

# OTP Settings
OTP_TEST_CODE=1234
OTP_EXPIRY_MINUTES=5
